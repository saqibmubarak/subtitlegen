# Host folder of videos. Use forward slashes on Windows so \n is not a newline.
# VIDEO_HOST_PATH=C:/Users/saqib/Videos/torrent/m/n/temp/30_Dressrosa
VIDEO_HOST_PATH=./videos
MODEL_CACHE_HOST_PATH=./model_cache
JOB_CACHE_HOST_PATH=./.subtitlegen-docker

# generate options read by the container. No extra compose command flags needed.
# fast = turbo. quality = large-v3 (used by the visual/whisper images).
# On Windows, Parakeet dialogue + OCR titles is two steps (see ReadMe):
#   docker compose --profile nemo run --rm parakeet
#   docker compose --profile ocr run --rm visual
# The parakeet service ignores this preset and always uses english-fast.
SUBTITLEGEN_PRESET=quality
SUBTITLEGEN_CACHE_DIR=/cache
# auto | mlx | faster-whisper | whisperx | parakeet
# SUBTITLEGEN_BACKEND=auto
# Optional: force a shipped series id. Leave unset to infer from file/folder names.
# SUBTITLEGEN_PROFILE=one-piece
# SUBTITLEGEN_ARC=Dressrosa
# Coarse Japanese scan interval, then densify this many seconds around hits.
SUBTITLEGEN_VISUAL_PROBE_SECONDS=4
SUBTITLEGEN_VISUAL_REFINE_SECONDS=12
# Fetch extra names from Wikipedia when the local glossary is thin.
SUBTITLEGEN_ENRICH_GLOSSARY=1
# Set to 1 only to rebuild existing SRT files.
# SUBTITLEGEN_OVERWRITE=0
